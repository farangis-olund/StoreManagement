<UserControl x:Class="PresentationWpf.Views.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PresentationWpf.Views"
              xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:views="clr-namespace:PresentationWpf.Views"
             xmlns:converters="clr-namespace:PresentationWpf.Converters"
             xmlns:viewmodels="clr-namespace:PresentationWpf.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:CustomerViewModel}"
             mc:Ignorable="d" 
           
             d:DesignHeight="450" d:DesignWidth="900">
    <UserControl.Resources>
        <converters:NullableDecimalConverter x:Key="NullableDecimalConverter"/>

        <Style x:Key="TransparentHoverButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#302D3E"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter x:Name="contentPresenter"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>

                            <!-- 🔵 HOVER EFFECT -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EEE"/>
                                <Setter Property="Foreground" Value="#000"/>
                                <!-- Text + Icon -->
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
           
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
        </Style>
    </UserControl.Resources>



    <DockPanel>
        <!-- Top Toolbar -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Background="#E0E5E6" Height="40" VerticalAlignment="Top">
            <Label Content="Перейти" VerticalAlignment="Center" Margin="5,0" Foreground="#302D3E" />
            <ComboBox Width="180" Height="27"
              Margin="0,0,20,0"
              VerticalAlignment="Center"
              FontSize="14"
              IsEditable="True"
              IsTextSearchEnabled="True"
              ItemsSource="{Binding Customers}"
              SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
              DisplayMemberPath="{Binding CustomerDisplayMemberPath}"
              StaysOpenOnEdit="True"
              TextSearch.TextPath="{Binding CustomerDisplayMemberPath}" />

            <Button Command="{Binding CreateCustomerCommand}" 
            Style="{StaticResource TransparentHoverButton}" 
            Margin="0,0,15,0" 
            Width="160" 
            VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Plus" 
                             
                             Width="12" 
                             Height="12" 
                             Margin="0,5,6,0"
                             VerticalAlignment="Center"  
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                             <TextBlock Text="Новый клиент" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding SaveCustomerCommand}"
                PreviewMouseLeftButtonDown="SaveButton_PreviewMouseLeftButtonDown"
                Click="SaveButton_Click"
                Style="{StaticResource TransparentHoverButton}" 
                Margin="0,0,15,0" 
                Width="120" 
                VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Save" 
                                 Width="14" 
                                 Height="14" 
                                 Margin="0,5,6,0"
                                 VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Сохранить" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" >
            <Grid Margin="10" HorizontalAlignment="left"  Width="auto" MaxWidth="1000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0" Margin="10,10,10,10" DataContext="{Binding SelectedCustomer}" >
                    <!-- ФИО -->
                    <TextBlock >
                          <Run Text="ФИО" Foreground="Black"/>
                          <Run Text="*" Foreground="Red"/>
                    </TextBlock>
                    <TextBox Height="32" Margin="0,0,0,5" VerticalContentAlignment="Center" Padding="5"
                Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" FontSize="14"/>

                    <!-- Email -->
                    <TextBlock Text="Email" />
                    <TextBox Height="32" Margin="0,0,0,5" VerticalContentAlignment="Center" Padding="5"
                    Text="{Binding Email,UpdateSourceTrigger=PropertyChanged}" FontSize="14"/>

                    <!-- Мобильный телефон -->
                    <TextBlock >
                        <Run Text="Мобильный телефон" Foreground="Black"/>
                        <Run Text="*" Foreground="Red"/>
                    </TextBlock>
                    
                    <TextBox Height="32" Margin="0,0,0,5" VerticalContentAlignment="Center" Padding="5"
                    Text="{Binding MobilePhone, UpdateSourceTrigger=PropertyChanged}" FontSize="14"/>

                    <!-- Адрес -->
                    <TextBlock >
                        <Run Text="Адрес" Foreground="Black"/>
                        <Run Text="*" Foreground="Red"/>
                    </TextBlock>
                    <TextBox Height="32" Margin="0,0,0,5" VerticalContentAlignment="Center" Padding="5"
                    Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" FontSize="14" />

                    <!-- Город -->
                    <TextBlock >
                            <Run Text="Город" Foreground="Black"/>
                            <Run Text="*" Foreground="Red"/>
                    </TextBlock>
                    <ComboBox Height="32" Margin="0,0,0,5" Padding="5"
                          ItemsSource="{Binding DataContext.DistinctCities, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding City, Mode=TwoWay}"
                          Text="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          FontSize="14"/>

                    <!-- Область -->
                    <TextBlock >
                        <Run Text="Область" Foreground="Black"/>
                        <Run Text="*" Foreground="Red"/>
                    </TextBlock>
                    <ComboBox Height="32" Margin="0,0,0,5" Padding="5"
                      ItemsSource="{Binding DataContext.DistinctRegions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      SelectedItem="{Binding Region, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Text="{Binding Region, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True"
                      FontSize="14"/>


                </StackPanel>

                <!-- Middle Column -->
                <StackPanel Grid.Column="1" Margin="10" DataContext="{Binding SelectedCustomer}">
                    <StackPanel Visibility="{Binding DataContext.PriceLevelAccess.CanView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock><Run Text="Уровень"/><Run Text=" *" Foreground="Red"/></TextBlock>
                        <ComboBox Height="32" Margin="0,0,0,5" FontSize="14" Padding="5"
                            IsEnabled="{Binding DataContext.PriceLevelAccess.CanInput, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=False}"
                            ItemsSource="{Binding DataContext.PriceLevels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            DisplayMemberPath="PriceType" SelectedValuePath="Level"
                            SelectedValue="{Binding PriceLevelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBlock Text="Примечания"/>
                    <TextBox Height="60" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,5" FontSize="14" Padding="5"
                        Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Visibility="{Binding DataContext.DebtAccess.CanView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="Задолженность"/>
                        <DockPanel LastChildFill="True">
                            <TextBox Height="32" Margin="0,0,0,5" FontSize="14" VerticalContentAlignment="Center" Padding="5"
                                IsEnabled="{Binding DataContext.DebtAccess.CanInput, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=False}"
                                Text="{Binding Debt, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding DataContext.RestrictionAccess.CanView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="Ограничение"/>
                        <DockPanel LastChildFill="True">
                            <TextBox Height="32" Margin="0,0,0,5" FontSize="14" VerticalContentAlignment="Center" Padding="5"
                                IsEnabled="{Binding DataContext.RestrictionAccess.CanInput, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=False}"
                                Text="{Binding Restriction, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding DataContext.BuyLimitAccess.CanView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="Лимит суммы заказа"/>
                        <DockPanel LastChildFill="True">
                            <TextBox Height="32" Margin="0,0,0,5" FontSize="14" VerticalContentAlignment="Center" Padding="5"
                                IsEnabled="{Binding DataContext.BuyLimitAccess.CanInput, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=False}"
                                Text="{Binding BuyLimit, Converter={StaticResource NullableDecimalConverter}, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding DataContext.UnpaidPaymentLimitAccess.CanView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="Лимит суммы неоплаченных платежей"/>
                        <DockPanel LastChildFill="True">
                            <TextBox Height="32" Margin="0,0,0,5" FontSize="14" VerticalContentAlignment="Center" Padding="5"
                                IsEnabled="{Binding DataContext.UnpaidPaymentLimitAccess.CanInput, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=False}"
                                Text="{Binding UnpaidPaymentLimit, Converter={StaticResource NullableDecimalConverter}, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Right Column -->
                <StackPanel Grid.Column="2" Margin="10" DataContext="{Binding SelectedCustomer}">
                    <StackPanel Visibility="{Binding DataContext.CoefficientsAccess.CanView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="КоэфОгрСумЗакупа"/>
                        <TextBox Height="32" Margin="0,0,0,5" FontSize="14" VerticalContentAlignment="Center" Padding="5"
                            IsEnabled="{Binding DataContext.CanInputPurchaseCoefficient, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=False}"
                            Text="{Binding DailyPurchaseCoefficient, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="КоэфЕжедПогашение"/>
                        <TextBox Height="32" Margin="0,0,0,5" FontSize="14" VerticalContentAlignment="Center" Padding="5"
                            IsEnabled="{Binding DataContext.CanInputRepaymentCoefficient, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=False}"
                            Text="{Binding DailyRepaymentCoefficient, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="КоэфПланирЗакупа"/>
                        <TextBox Height="32" Margin="0,0,0,5" FontSize="14" VerticalContentAlignment="Center" Padding="5"
                            IsEnabled="{Binding DataContext.CanInputPlannedPurchaseCoefficient, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=False}"
                            Text="{Binding DailyPlannedPurchaseCoefficient, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"/>
                        <DockPanel>
                            <Button Content="Расчет коэф" Height="28" Margin="0,0,0,5"
                                Command="{Binding DataContext.CalculateCoefficientsForCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding DataContext.ContractDateAccess.CanView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="Дата контракта"/>
                        <DockPanel LastChildFill="True">
                            <DatePicker SelectedDate="{Binding ContractDate, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14" Padding="5" Margin="0,0,0,5"
                                IsEnabled="{Binding DataContext.ContractDateAccess.CanInput, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=False}"/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding DataContext.TerritoryAccess.CanView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock><Run Text="Территория"/><Run Text=" *" Foreground="Red"/></TextBlock>
                        <ComboBox Height="32" Margin="0,0,0,5" FontSize="14" Padding="5"
                            IsEnabled="{Binding DataContext.TerritoryAccess.CanInput, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=False}"
                            ItemsSource="{Binding DataContext.DistinctTerritories, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            SelectedItem="{Binding Territory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Text="{Binding Territory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"/>
                    </StackPanel>

                    <CheckBox Content="ИсключитьЕжедПогашение" FontSize="14" Margin="0,5,0,5"
                        Visibility="{Binding DataContext.ExcludeDailyRepaymentAccess.CanView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"
                        IsEnabled="{Binding DataContext.ExcludeDailyRepaymentAccess.CanInput, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=False}"
                        IsChecked="{Binding ExcludeDailyRepayment, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Visibility="{Binding DataContext.SalesManagerAccess.CanView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock><Run Text="Менеджер по продажам"/><Run Text=" *" Foreground="Red"/></TextBlock>
                        <ComboBox Height="32" Margin="0,0,0,5" FontSize="14" Padding="5"
                            IsEnabled="{Binding DataContext.SalesManagerAccess.CanInput, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=False}"
                            ItemsSource="{Binding DataContext.SalesManagers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            DisplayMemberPath="FullName" SelectedValuePath="Id"
                            SelectedValue="{Binding SalesManagerId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <CheckBox Content="Официальный клиент" Margin="0,5,0,0"
                        IsChecked="{Binding OfficialCustomer, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer> 
    </DockPanel>
</UserControl>

    
    
