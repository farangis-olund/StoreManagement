<UserControl x:Class="PresentationWpf.Views.OfficialMonthlyPlansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FDFFFE" FontSize="14" Language="ru-RU">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIf"/>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Месячные планы официальных клиентов" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <WrapPanel Grid.Row="1" Background="{StaticResource AdminTopBackground}" Margin="0,0,0,12">
            <RadioButton Content="Контроль выполнения" Style="{StaticResource AdminTopButtonStyle}" GroupName="PlanModes"
                         IsChecked="{Binding ShowControl, Mode=OneWay}" Command="{Binding ShowControlTableCommand}"
                         Visibility="{Binding CanView, Converter={StaticResource VisibleIf}}"/>
            <RadioButton Content="Настройка планов" Style="{StaticResource AdminTopButtonStyle}" GroupName="PlanModes"
                         IsChecked="{Binding ShowSettings, Mode=OneWay}" Command="{Binding ShowPlanSettingsCommand}"
                         Visibility="{Binding CanManage, Converter={StaticResource VisibleIf}}"/>
        </WrapPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
            </Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="Месяц" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="150" Height="36" ItemsSource="{Binding Months}" DisplayMemberPath="Name" SelectedValuePath="Number"
                      SelectedValue="{Binding SelectedMonth, Mode=TwoWay}" Margin="0,0,8,0"/>
            <ComboBox Width="100" Height="36" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear, Mode=TwoWay}" Margin="0,0,12,0"/>
            <TextBlock Text="Клиент" VerticalAlignment="Center" Margin="0,0,8,0"
                       Visibility="{Binding ShowControl, Converter={StaticResource VisibleIf}}"/>
            <ComboBox x:Name="CustomerPlanFilter" Width="280" Height="36" Margin="0,0,12,0"
                      ItemsSource="{Binding CustomerFilters}" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedCustomerId, Mode=TwoWay}"
                      Visibility="{Binding ShowControl, Converter={StaticResource VisibleIf}}"/>
            <Button x:Name="ShowPlansButton" Content="Показать" Command="{Binding RefreshCommand}" Style="{StaticResource GrayButton}" Width="120" Height="36"/>
            <Button x:Name="SavePlansButton" Content="Сохранить" Command="{Binding SaveCommand}" Style="{StaticResource GreenButton}"
                    Width="120" Height="36" Margin="8,0,0,0" IsEnabled="{Binding CanEdit}"
                    Visibility="{Binding ShowSettings, Converter={StaticResource VisibleIf}}"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <StackPanel x:Name="PlanThresholdSettings" Margin="0,0,0,10" IsEnabled="{Binding CanEdit}"
                        Visibility="{Binding ShowSettings, Converter={StaticResource VisibleIf}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Порог обычного заказа" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="NonOfficialThresholdBox" Width="100" Height="34" Padding="6,2" VerticalContentAlignment="Center"
                             Text="{Binding NonOfficialThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Общий для всех клиентов и месяцев" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBlock Text="Если остаток по плану меньше или равен порогу, новый заказ оформляется как обычный."
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
        </StackPanel>
        <DataGrid x:Name="ControlGrid" Grid.Row="4" ItemsSource="{Binding VisibleRows}" Style="{StaticResource SummaryGrid}"
                  Visibility="{Binding ShowControl, Converter={StaticResource VisibleIf}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код клиента" Binding="{Binding CustomerId}" Width="130"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="*" MinWidth="180"/>
                <DataGridTextColumn Header="План" Binding="{Binding Amount, StringFormat=N2}" Width="150"/>
                <DataGridTextColumn Header="Продажа" Binding="{Binding Purchased, StringFormat=N2}" Width="150"/>
                <DataGridTextColumn Header="Остаток" Binding="{Binding Remaining, StringFormat=N2}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <DataGrid x:Name="SettingsGrid" Grid.Row="4" ItemsSource="{Binding Rows}" Style="{StaticResource SummaryGrid}"
                  IsReadOnly="False" IsEnabled="{Binding CanEdit}" RowHeight="44"
                  Visibility="{Binding ShowSettings, Converter={StaticResource VisibleIf}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код клиента" Binding="{Binding CustomerId}" IsReadOnly="True" Width="130"/>
                <DataGridTextColumn Header="Официальный клиент" Binding="{Binding CustomerName}" IsReadOnly="True" Width="*" MinWidth="180"/>
                <DataGridTemplateColumn Header="План на месяц" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBox Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               Margin="4" Padding="6,2" VerticalContentAlignment="Center"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"
                    Visibility="{Binding ShowControl, Converter={StaticResource VisibleIf}}">
            <TextBlock Text="Итого:" FontWeight="Bold" Margin="0,0,16,0"/>
            <TextBlock Text="{Binding TotalPlan, StringFormat='План: {0:N2}'}" Margin="0,0,20,0"/>
            <TextBlock Text="{Binding TotalPurchased, StringFormat='Продажа: {0:N2}'}" Margin="0,0,20,0"/>
            <TextBlock Text="{Binding TotalRemaining, StringFormat='Остаток: {0:N2}'}" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</UserControl>
