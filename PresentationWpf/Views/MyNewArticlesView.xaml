<UserControl x:Class="PresentationWpf.Views.MyNewArticlesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PresentationWpf.Views"
             xmlns:viewmodels="clr-namespace:PresentationWpf.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:MyNewArticlesViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="#FDFFFE" FontSize="14">
    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Left" Content="← На главную" Style="{StaticResource GrayButton}"
                    Width="160" Height="36" Margin="0,0,16,0"
                    Command="{Binding GoHomeCommand}"/>
            <TextBlock Text="Мои новые артикулы" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Обновить заявки" Command="{Binding RefreshDraftsCommand}"
                    Style="{StaticResource GrayButton}" Width="170" Height="36"/>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Drafts}" SelectedItem="{Binding SelectedDraft}" Style="{StaticResource SummaryGrid}"
                      RowHeight="34" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" ElementStyle="{StaticResource TextCellStyle}"/>
                    <DataGridTextColumn Header="Артикул" Binding="{Binding ArticleNumber}" Width="*" ElementStyle="{StaticResource TextCellStyle}"/>
                    <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" ElementStyle="{StaticResource NumberCellStyle}"/>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="*" ElementStyle="{StaticResource TextCellStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel IsEnabled="{Binding CanEditDraft}">
                    <TextBlock Text="Характеристики товара" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding SelectedDraft.ArticleNumber}" FontSize="16" Margin="0,0,0,8"/>
                    <TextBlock Text="Наименование *"/>
                    <TextBox Text="{Binding SelectedDraft.ProductName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Padding="5" Margin="0,3,0,8"/>
                    <TextBlock Text="Бренд *"/>
                    <TextBox Text="{Binding SelectedDraft.BrandName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Padding="5" Margin="0,3,0,8"/>
                    <TextBlock Text="Марка *"/>
                    <TextBox Text="{Binding SelectedDraft.Marka, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" Padding="5" Margin="0,3,0,8"/>
                    <TextBlock Text="Модель *"/>
                    <TextBox Text="{Binding SelectedDraft.Model, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Padding="5" Margin="0,3,0,8"/>
                    <TextBlock Text="Группа *"/>
                    <TextBox Text="{Binding SelectedDraft.GroupName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Padding="5" Margin="0,3,0,8"/>
                    <TextBlock Text="Альтернативный артикул"/>
                    <TextBox Text="{Binding SelectedDraft.Alternative, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" Padding="5" Margin="0,3,0,8"/>
                    <TextBlock Text="Примечание"/>
                    <TextBox Text="{Binding SelectedDraft.Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55" Padding="5" Margin="0,3,0,10"/>
                    <WrapPanel>
                        <Button Content="Сохранить черновик" Command="{Binding SaveDraftCommand}" Style="{StaticResource GrayButton}"
                                Width="185" Height="38" Margin="0,0,8,8"/>
                        <Button Content="Отправить заявку" Command="{Binding SubmitDraftCommand}" Style="{StaticResource GreenButton}"
                                Width="180" Margin="0,0,0,8"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
