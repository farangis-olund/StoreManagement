<Window x:Class="PresentationWpf.Views.WarehousePlaceImportErrorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ошибки импорта мест на складе" Width="1000" Height="650" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="White">
    <Window.Resources>
        <Style x:Key="ImportIssueCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Печать списка" Command="{Binding PrintCommand}" Style="{StaticResource GrayButton}" Width="140" Height="32"/>
            <TextBlock Text="Не загруженные строки" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Grid.Row="1" Text="{Binding FileDescription}" Foreground="#647078" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="2" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <DataGrid Grid.Row="3" ItemsSource="{Binding Issues}" Style="{StaticResource SummaryGrid}" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" RowHeight="NaN" MinRowHeight="28" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Строка Excel" Binding="{Binding RowNumber, Mode=OneWay}" Width="100" ElementStyle="{StaticResource ImportIssueCell}"/>
                <DataGridTextColumn Header="Артикул" Binding="{Binding ArticleNumber, Mode=OneWay}" Width="190" ElementStyle="{StaticResource ImportIssueCell}"/>
                <DataGridTextColumn Header="Место" Binding="{Binding WarehousePlace, Mode=OneWay}" Width="150" ElementStyle="{StaticResource ImportIssueCell}"/>
                <DataGridTextColumn Header="Причина" Binding="{Binding Reason, Mode=OneWay}" Width="*" MinWidth="250" ElementStyle="{StaticResource ImportIssueCell}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="4" Text="{Binding Message}" Foreground="#A34419" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
</Window>
