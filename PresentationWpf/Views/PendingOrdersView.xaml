<UserControl x:Class="PresentationWpf.Views.PendingOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="500">

    <Grid Background="White" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Список неотправленных заказов"
                   FontSize="16" FontWeight="Bold" 
                   Margin="10" />

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding PendingOrders}" 
                  SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  Margin="0,10,0,10"
                  Style="{StaticResource SummaryGrid}">
            <DataGrid.Columns>
                 <DataGridTextColumn Header="№ Накладной" Binding="{Binding InvoiceNumber}" Width="180"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="180"/>
                <DataGridTextColumn Header="Код клиента" Binding="{Binding CustomerId}" Width="*" ElementStyle="{StaticResource CenterCellStyle}" />

            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </Grid>
</UserControl>
