<UserControl x:Class="PresentationWpf.Views.Welcome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FDFFFE" FontSize="14">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding WelcomeMessage}" FontSize="24" Margin="0,0,0,24"/>
        <TextBlock FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left">
            <Hyperlink x:Name="MyNewArticlesLink" Foreground="#566366"
                       Command="{Binding DataContext.NavigateToMyNewArticlesCommand, RelativeSource={RelativeSource AncestorType=Window}}">Мои новые артикулы</Hyperlink>
        </TextBlock>
    </StackPanel>
</UserControl>
