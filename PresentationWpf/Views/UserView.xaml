<UserControl x:Class="PresentationWpf.Views.UserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="+ Новый" Style="{StaticResource GrayButton}" Width="110" Margin="2" Command="{Binding AddNewUserCommand}"/>
            <Button Content="Добавить" Style="{StaticResource GrayButton}" Width="110" Margin="2" Command="{Binding AddUserCommand}"/>
            <Button Content="Изменить" Style="{StaticResource GrayButton}" Width="110" Margin="2" Command="{Binding UpdateUserCommand}"/>
            <Button Content="Удалить" Style="{StaticResource GrayButton}" Width="110" Margin="2" Command="{Binding DeleteUserCommand}"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,10" IsEnabled="{Binding IsNotBusy}">
            <StackPanel Margin="0,0,10,10"><TextBlock Text="Логин *"/>
                <TextBox Width="140" Height="32" Text="{Binding CurrentUser.UserName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Margin="0,0,10,10"><TextBlock Text="Имя *"/>
                <TextBox Width="140" Height="32" Text="{Binding CurrentUser.FirstName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Margin="0,0,10,10"><TextBlock Text="Фамилия *"/>
                <TextBox Width="140" Height="32" Text="{Binding CurrentUser.LastName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Margin="0,0,10,10"><TextBlock Text="Электронная почта"/>
                <TextBox Width="180" Height="32" Text="{Binding CurrentUser.Email, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Margin="0,0,10,10"><TextBlock Text="Телефон"/>
                <TextBox Width="150" Height="32" Text="{Binding CurrentUser.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Margin="0,0,10,10"><TextBlock Text="Адрес"/>
                <TextBox Width="240" Height="32" Text="{Binding CurrentUser.Address, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Margin="0,0,10,10"><TextBlock Text="Пароль *"/>
                <TextBox Width="140" Height="32" Text="{Binding CurrentUser.Password, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Margin="0,0,10,10"><TextBlock Text="Роль *"/>
                <ComboBox Width="220" Height="32" ItemsSource="{Binding Roles}" DisplayMemberPath="RoleName" SelectedItem="{Binding SelectedRole}"/></StackPanel>
            <CheckBox Content="Менеджер" Margin="0,18,18,10" VerticalAlignment="Center" IsChecked="{Binding CurrentUser.IsManager}"/>
        </WrapPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Users}" Style="{StaticResource SummaryGrid}"
                  SelectedItem="{Binding SelectedUser}" IsEnabled="{Binding IsNotBusy}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding UserName}" Width="130"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="130"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="130"/>
                <DataGridTextColumn Header="Эл. почта" Binding="{Binding Email}" Width="170"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneNumber}" Width="140"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="200"/>
                <DataGridCheckBoxColumn Header="Менеджер" Binding="{Binding IsManager, Mode=OneWay}" Width="100"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding UserRoles[0].Role.RoleName}" Width="*" MinWidth="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
